# Desktop defaults. Copy this file to .env; never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
APP_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
AUTH_MODE=desktop
DESKTOP_TENANT_ID=soxtech-demo
DESKTOP_USER_ID=desktop-owner
DESKTOP_ROLE=admin

# Production OIDC: use Microsoft Entra ID, Auth0, Okta, or another OIDC provider.
# AUTH_MODE=oidc
# OIDC_ISSUER=https://your-provider.example.com/your-tenant/v2.0
# OIDC_AUDIENCE=api://soxtech-erp-sim-aiudit
# OIDC_TENANT_CLAIM=tid
# OIDC_ROLE_CLAIM=roles

# OpenAI Responses API. Keep the key only in the environment or a secret manager.
OPENAI_ENABLED=false
# OPENAI_API_KEY=
ORCHESTRATOR_MODEL=gpt-5.6-sol
ORCHESTRATOR_REASONING=xhigh
FALLBACK_MODEL=gpt-5.5-pro
ORCHESTRATOR_MAX_TOKENS=2400
ORCHESTRATOR_MAX_STEPS=8
ORCHESTRATOR_MAX_DELEGATIONS=4
PROMPT_CACHE_PREFIX=soxtech:agent-os:v2

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AGENT_RATE_LIMIT_MAX=15
BODY_LIMIT_BYTES=262144
