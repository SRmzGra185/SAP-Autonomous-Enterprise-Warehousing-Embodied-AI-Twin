# Optional, inert fill-later cloud worksheet. This file does not load itself.
# The pure profile module never reads environment variables or files.
# Leave unknown values blank. Do not enter passwords, keys, tokens, or usernames.
# Future import must be explicitly scoped to an authorized server tenant by main.
# Safety constants only; no environment value can enable SAP connectivity.
SAP_CONNECTIONS_READ_ONLY=true
SAP_CONNECTIONS_LIVE_ENABLED=false
SAP_CONNECTIONS_TESTS_ENABLED=false

# Only BDC Connect and Joule are connections; scenarios reuse these profiles.
# ENVIRONMENT: blank, mock, sandbox, or production (all production checks denied).
# Kind is cloud. TENANT_URL is an origin, DESTINATION is a symbolic name.
SAP_BDC_CONNECT_ENVIRONMENT=
SAP_BDC_CONNECT_TENANT_URL=
SAP_BDC_CONNECT_DESTINATION=

SAP_JOULE_ENVIRONMENT=
SAP_JOULE_TENANT_URL=
SAP_JOULE_DESTINATION=
